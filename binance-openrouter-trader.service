[Unit]
Description=Binance OpenRouter Trader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Run the portfolio trading scheduler as the regular Ubuntu user.
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/binance-openrouter-trader
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/binance-openrouter-trader/venv/bin/python -u /home/ubuntu/binance-openrouter-trader/main.py
Restart=always
RestartSec=15
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
